# ─── Environment ─────────────────────────────────────────────────
# Application mode: development | production
APP_ENV=development

# ─── Database ────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/voiceguard.db

# ─── Storage ─────────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/artifacts
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ─── Authentication (REQUIRED — generate a unique value) ─────────
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_GENERATE_A_REAL_SECRET
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14

# ─── AI Models ───────────────────────────────────────────────────
# Local path or HuggingFace Hub repo ID (with @commit-sha)
ACOUSTIC_MODEL_ID=
ACOUSTIC_BORDERLINE_LOW=0.35
ACOUSTIC_BORDERLINE_HIGH=0.65

WHISPER_MODEL_SIZE=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGES=en,hi,mr,bn,ta

SCAM_MODEL_ID=
FUSION_MODEL_PATH=

# ─── Verdict thresholds ─────────────────────────────────────────
VERDICT_THRESHOLD_MODERATE=0.30
VERDICT_THRESHOLD_HIGH=0.65

# ─── Upload limits ──────────────────────────────────────────────
MAX_UPLOAD_MB=25
MAX_DURATION_SECONDS=300
MIN_DURATION_SECONDS=1.5

# ─── Concurrency ────────────────────────────────────────────────
MAX_CONCURRENT_INFERENCE=2

# ─── Device ─────────────────────────────────────────────────────
# auto | cpu | cuda
DEVICE=auto

# ─── Retention ──────────────────────────────────────────────────
RETENTION_DAYS=30

# ─── CORS ───────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ─── Logging ────────────────────────────────────────────────────
LOG_LEVEL=INFO
